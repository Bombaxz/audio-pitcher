// Sitio estático de Audio Pitcher en Cloudflare (Workers con assets estáticos)
{
  "name": "audio-pitcher",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "audiopitcher.app", "custom_domain": true },
    { "pattern": "www.audiopitcher.app", "custom_domain": true }
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./web",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
